<% if (items.length === 0) { %>
<p class="post-list-empty">Nothing published yet.</p>
<% } else { %>
<ul class="post-list list">
<% for (const item of items) { %>
<li class="post-list-item" <%= metadataAttrs(item) %>>
<a class="post-list-title" href="<%- item.path %>"><%= item.title %></a><% if (item.draft) { %> <span class="post-list-draft">Draft</span><% } %>
<% if (item.description) { %><p class="post-list-desc"><%= item.description %></p><% } %>
<p class="post-list-meta"><%= item.date %><% if (item['reading-time']) { %> · <%= item['reading-time'] %> read<% } %></p>
</li>
<% } %>
</ul>
<% } %>
